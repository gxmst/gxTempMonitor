<Window x:Class="TempMonitor.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 gxTempMonitor" Width="620" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#11131A" Foreground="#EDF2F7"
        FontFamily="Segoe UI, Microsoft YaHei" UseLayoutRounding="True">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="assets/app.ico" Width="82" Height="82" Margin="0,0,22,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="欢迎使用 gxTempMonitor" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="安静、透明的 Windows 桌面状态挂件" Foreground="#9BA8BA" FontSize="14" Margin="0,7,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,20">
            <Border Background="#1A1D26" BorderBrush="#343A48" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="拖动与锁定" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="拖动挂件调整位置；锁定后启用鼠标穿透，可从托盘解除。" Foreground="#AAB5C4" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Background="#1A1D26" BorderBrush="#343A48" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="双击打开 Dashboard" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="查看历史趋势、硬件详情、系统运行时间、电池和磁盘状态。" Foreground="#AAB5C4" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Background="#1A1D26" BorderBrush="#343A48" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel><TextBlock Text="安全边界" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="程序不安装驱动、不注入其他进程；CPU 温度按设计不采集。" Foreground="#AAB5C4" Margin="0,6,0,0"/></StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打开设置" Width="104" Height="36" Margin="0,0,10,0" Click="OpenSettings_Click"/>
            <Button Content="开始使用" Width="104" Height="36" IsDefault="True" Background="#28B8F7" Foreground="#07131A" BorderThickness="0" FontWeight="SemiBold" Click="Start_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="TempMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gxTempMonitor 设置"
        Width="780" Height="680" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#11131A" Foreground="#EDF2F7"
        FontFamily="Segoe UI, Microsoft YaHei" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1D26"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#343A48"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#98A4B5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#28B8F7"/>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5EAF0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#07131A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2A2F3B"/>
            <Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,7,12,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,14">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="显示、设备、告警和低干扰选项" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <GroupBox Header="挂件显示项">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="MetricListBox" MinHeight="200" BorderBrush="{StaticResource BorderBrush}"
                                         Background="#12151C" ItemsSource="{Binding MetricItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsVisible}" Content="{Binding DisplayName}"
                                                      Padding="4" Width="360"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Button Content="上移" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="MoveMetricUp_Click"/>
                                    <Button Content="下移" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="MoveMetricDown_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="数值格式">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="GPU 主数值" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="GpuDisplayMetricComboBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Grid.Column="2" Text="挂件网络单位" Style="{StaticResource FieldLabelStyle}" Margin="18,7,12,7"/>
                                <ComboBox x:Name="NetworkUnitComboBox" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Grid.Row="1" Text="内存显示" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="RamDisplayModeComboBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="显存显示" Style="{StaticResource FieldLabelStyle}" Margin="18,7,12,7"/>
                                <ComboBox x:Name="VramDisplayModeComboBox" Grid.Row="1" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="外观">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="挂件主题" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Grid.Row="1" Text="透明度" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider" Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" HorizontalAlignment="Right" Text="78%"/>
                                </Grid>
                                <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Row="2" Grid.Column="1" Content="挂件始终置顶"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="设备">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <GroupBox Header="GPU">
                            <StackPanel>
                                <TextBlock Text="默认自动选择活跃设备；固定设备不可用时会安全回退。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="GpuDeviceComboBox" DisplayMemberPath="Label"/>
                                <TextBlock Text="Windows Provider 使用当前 Windows 会话内的 LUID；重启或驱动重置后可能回退到自动选择。"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="网络接口">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="选择方式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="NetworkSelectionModeComboBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="NetworkSelectionModeComboBox_SelectionChanged"/>
                                <TextBlock Grid.Row="1" Text="固定网卡" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="NetworkInterfaceComboBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label"/>
                            </Grid>
                        </GroupBox>
                        <Button x:Name="RefreshDevicesButton" Content="刷新设备列表" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="RefreshDevices_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="告警">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <CheckBox x:Name="EnableAlertsCheckBox" Content="启用告警规则" FontWeight="SemiBold"/>
                        <GroupBox Header="阈值">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="CPU 使用率" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="CpuAlertThresholdTextBox" Grid.Column="1"/>
                                <TextBlock Grid.Column="2" Text="%（50–100）" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                                <TextBlock Grid.Row="1" Text="GPU 温度" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="GpuAlertThresholdTextBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="°C（40–120）" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                                <TextBlock Grid.Row="2" Text="内存使用率" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RamAlertThresholdTextBox" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="%（50–100）" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="防抖与提醒">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="提醒方式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="AlertPresentationComboBox" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <TextBlock Grid.Row="1" Text="持续超过阈值" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="AlertSustainTextBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="秒" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                                <TextBlock Grid.Row="2" Text="恢复滞回" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="AlertHysteresisTextBox" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="降低这么多后解除" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                                <TextBlock Grid.Row="3" Text="提醒冷却" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="AlertCooldownTextBox" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="秒" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="低干扰">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <GroupBox Header="采样与全屏">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="采样间隔" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SamplingIntervalComboBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                <CheckBox x:Name="AdaptiveSamplingCheckBox" Grid.Row="1" Grid.Column="1" Content="挂件和 Dashboard 均不可见时自动降低采样频率"/>
                                <TextBlock Grid.Row="2" Text="检测到全屏应用" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="FullscreenBehaviorComboBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="可选的系统交互">
                            <StackPanel>
                                <CheckBox x:Name="GlobalHotkeyCheckBox" Content="注册全局热键 Ctrl+Shift+M"/>
                                <CheckBox x:Name="ProcessTrackingCheckBox" Content="查询进程级 GPU 显存（汇总全部 GPU，默认关闭）"/>
                                <TextBlock Text="关闭时不会执行对应 PID 名称查询；全屏检测只比较窗口边界，不安装钩子。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="开机启动延迟">
                            <ComboBox x:Name="DelayedStartComboBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="诊断">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="以下信息只在本机生成，不会自动上传；报告会省略用户名、完整路径和进程列表。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox x:Name="DiagnosticsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="导入配置" Style="{StaticResource SecondaryButtonStyle}" Click="ImportConfig_Click"/>
                        <Button Content="导出配置" Style="{StaticResource SecondaryButtonStyle}" Click="ExportConfig_Click"/>
                        <Button x:Name="CheckUpdatesButton" Content="手动检查更新" Style="{StaticResource SecondaryButtonStyle}" Click="CheckUpdates_Click"/>
                        <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshDiagnostics_Click"/>
                        <Button Content="复制报告" Style="{StaticResource SecondaryButtonStyle}" Click="CopyDiagnostics_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Content="应用" Style="{StaticResource SecondaryButtonStyle}" Click="Apply_Click"/>
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
